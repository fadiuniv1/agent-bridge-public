# Copy to a systemd EnvironmentFile or export in the service environment.
# Never commit real values.
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_FAST_MODEL=
CLOUD_STRONG_MODEL=

# Optional auth. These are two different tokens/headers:
# BRIDGE_API_TOKEN        -> X-Bridge-Token on /api/* and /v1/* (health and integrity exempt)
# AGENT_BRIDGE_API_TOKEN  -> Authorization: Bearer on ALL paths for non-loopback clients
BRIDGE_API_TOKEN=
AGENT_BRIDGE_API_TOKEN=
